<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_DEBUG" value="true"/>
    <env name="APP_URL" value="http://localhost"/>
    <env name="APP_CONFIG_CACHE" value="/tmp/lsky-phpunit-config.php"/>
    <env name="APP_PACKAGES_CACHE" value="/tmp/lsky-phpunit-packages.php"/>
    <env name="APP_SERVICES_CACHE" value="/tmp/lsky-phpunit-services.php"/>
    <env name="APP_ROUTES_CACHE" value="/tmp/lsky-phpunit-routes.php"/>
    <env name="APP_EVENTS_CACHE" value="/tmp/lsky-phpunit-events.php"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="DB_CONNECTION" value="sqlite"/>
    <env name="DB_DATABASE" value="/tmp/lsky-phpunit.sqlite"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="UPLOAD_PIPELINE_QUEUE_CONNECTION" value="sync"/>
    <env name="IMAGE_DELETE_QUEUE_CONNECTION" value="sync"/>
    <env name="WEBHOOK_QUEUE_CONNECTION" value="sync"/>
    <env name="AI_PROMPT_QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
    <env name="VIEW_COMPILED_PATH" value="/tmp/lsky-phpunit-views"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
